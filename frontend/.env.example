# Flask backend base URL (no trailing slash). Baked into the bundle at
# BUILD time — changing it requires a rebuild/redeploy. On Vercel set
# this to the Render backend URL, e.g.
# VITE_API_BASE_URL=https://realestate-valuation-api.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:5000

# Local blockchain JSON-RPC endpoint (Hardhat default) — used by the
# Blockchain Explorer probe only.
VITE_CHAIN_RPC_URL=http://127.0.0.1:8545

# Deployed PropertyToken contract address (empty until the blockchain
# stage deploys it).
VITE_CONTRACT_ADDRESS=
