# Copy to .env and adjust. Never commit a real .env.
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# MongoDB for valuation history (Atlas URI in hosted deployments)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=real_estate_valuation
HISTORY_COLLECTION=valuation_history
DB_TIMEOUT_MS=1500
# HISTORY_BACKEND=mongo   (default) | memory (dev only, process-local)

# React frontend origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Prototype token denomination: 1 token per ₹10,000 of valuation
TOKEN_DENOMINATION_INR=10000

# Optional: override packaged-model directory
# MODEL_DIR=/absolute/path/to/backend/ml

# Blockchain bridge (local Hardhat network)
CHAIN_RPC_URL=http://127.0.0.1:8545
# CHAIN_DEPLOYMENT_FILE=/absolute/path/to/blockchain/deployments/localhost.json
# CHAIN_ABI_FILE=/absolute/path/to/blockchain/abi/PropertyToken.json
# Bridge wallet key. Leave unset for a local Hardhat node (the bridge
# then uses the node's first unlocked test account). NEVER put a real
# key here or commit a filled .env.
CHAIN_PRIVATE_KEY=

# Administrative API key for POST /api/chain/register and /api/chain/mint
# (sent as the X-Admin-Key header). Set a long random value in any
# shared/production deployment; unset = local development only.
ADMIN_API_KEY=
